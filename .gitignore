# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report
/test-results

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

!.env.local.example

# data backups (scripts/exportData.ts) — can contain real personal data
/backups

# claude code / codex — local settings and git worktrees, not shared repo state
/.claude
/.codex
# Pins a skill that lives under the ignored /.claude — committing a lockfile
# for something absent from the repo would pin nothing.
/skills-lock.json

# A standalone Figma-export reference project (its own Vite app, its own deps),
# kept on disk for design comparison while the Home hub was built. Not app code
# and not part of the build — already excluded from tsconfig.json,
# eslint.config.mjs and .prettierignore; this keeps it out of git status too.
# Safe to delete once it has stopped being a useful reference.
/Redesign landing page (1)/
